NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# 只放在伺服器（Vercel 環境變數），絕不能加 NEXT_PUBLIC_。查詢、修改、取消報名用（ADR 0009）。
SUPABASE_SECRET_KEY=your-secret-key
# 確認信用 Resend 寄出（#14）。只放在伺服器，絕不能加 NEXT_PUBLIC_。沒設定時報名照常，寄信紀錄記下失敗。
RESEND_API_KEY=
# 寄件人，網域要先在 Resend 驗證，例如：台灣姐妹大會 <noreply@your-domain>
EMAIL_FROM=
